    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-table": "^8.21.3",
    "babylonjs-hook": "^0.1.1",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "framer-motion": "^12.37.0",
